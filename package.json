{
  "name": "pebble-strava",
  "author": "clet",
  "version": "1.9.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Strava GPX",
    "shortName": "Strava GPX",
    "longName": "Strava GPX",
    "uuid": "136a1e15-7d76-4072-8046-fd01c7562f82",
    "companyName": "clet",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": ["location", "configurable", "health"],
    "companionApp": {
      "android": {
        "url": "https://github.com/cletqui/pebble-strava/releases",
        "apps": [
          { "package": "re.clet.pebblestrava.debug" },
          { "package": "re.clet.pebblestrava" }
        ]
      }
    },
    "messageKeys": [
      "CMD_ACTION",
      "CMD_SPORT",
      "HR_BPM",
      "GPS_DISTANCE",
      "GPS_SPEED",
      "GPS_HAS_FIX",
      "UPLOAD_STATUS",
      "UPLOAD_MSG",
      "CRED_REQUEST",
      "CRED_URL",
      "CRED_SECRET",
      "WORKER_STATUS",
      "SETTINGS_HR_INTERVAL_CYCLING",
      "SETTINGS_HR_INTERVAL_RUNNING",
      "SETTINGS_HR_INTERVAL_WALKING",
      "SETTINGS_GPS_ACCURACY",
      "SETTINGS_UNITS",
      "SETTINGS_DOWNLOAD_SUBFOLDER"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_STRAVA_LOGO",
          "file": "images/strava_logo.png"
        },
        {
          "type": "font",
          "name": "FONT_ICONS_14",
          "file": "fonts/icons.ttf",
          "characterRegex": "[\\u0020-\\u007E\\u25A0\\u25B2\\u25B6\\u25BC\\u25C0\\u2713]"
        }
      ]
    }
  }
}
